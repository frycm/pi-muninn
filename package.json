{
	"name": "pi-muninn",
	"version": "0.1.0",
	"description": "Searchable, local-first project journals for pi",
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./integration": {
			"types": "./dist/integrations/protocol.d.ts",
			"import": "./dist/integrations/protocol.js"
		}
	},
	"bin": {
		"muninn": "./dist/cli.js"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "tsc --noEmit && biome check src test scripts",
		"format": "biome check --write src test scripts",
		"test": "vitest --run",
		"test:unit": "vitest --run test/unit",
		"test:integration": "vitest --run --passWithNoTests test/integration",
		"test:perf": "vitest --run test/unit/query-perf.test.ts",
		"build": "tsc -p tsconfig.build.json",
		"test:package": "node scripts/package-smoke.mjs",
		"test:eval": "npm run build && node scripts/evaluate.mjs",
		"eval:memory": "npm run build && node scripts/evaluate-memory.mjs",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@types/node": "22.19.0",
		"@types/proper-lockfile": "4.1.4",
		"typescript": "5.7.2",
		"vitest": "3.2.6"
	},
	"dependencies": {
		"@earendil-works/pi-server": "0.85.0",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.7"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	]
}
